# Скопируйте этот файл в .env и задайте свои значения. Сам .env в Git не добавляется.

# Ключ подписи сессий. На сервере обязательно свой: openssl rand -hex 32
# Если оставить значение ниже без изменений, приложение НЕ запустится: этот образец лежит в открытом репозитории.
SECRET_KEY=замените-на-длинную-случайную-строку

# Путь к базе. В Docker переопределяется на /data/requests.db
DATABASE_PATH=requests.db

# Для запуска через python app.py
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Защита от подбора пароля: после стольких неудачных попыток подряд вход для пары «адрес + логин»
# закрывается на LOGIN_WINDOW_SECONDS секунд (ответ 429). 0 отключает ограничение.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Порт на сервере для docker compose (80 — сайт открывается по http://адрес/ без номера порта)
APP_PORT=80
